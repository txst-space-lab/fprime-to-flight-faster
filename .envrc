# Requires: direnv + nix with flakes enabled.
# Run `direnv allow` once to trust this file.

# Fall back to a plain nix-shell message if flakes are unavailable.
if ! has nix; then
  log_error "nix not found — install Nix, then run: direnv allow"
  return 0
fi

use flake

# Cache the built environment so the shell doesn't re-evaluate on every cd.
watch_file flake.nix
watch_file flake.lock

# Local, gitignored overrides (e.g. private font paths, scratch env vars).
source_env_if_exists .envrc.local
